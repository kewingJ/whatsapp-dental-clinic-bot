# ─────────────────────────────────────────────
# WhatsApp Cloud API (Meta)
# ─────────────────────────────────────────────
# Access token from Meta App Dashboard > API Setup
# This token expires after 24 hours unless you create a system user token
# https://business.facebook.com/settings/system-users
ACCESS_TOKEN=""

APP_ID=""
APP_SECRET=""
RECIPIENT_WAID=""       # Your WhatsApp number with country code (e.g., +50588881234)
VERSION="v25.0"
PHONE_NUMBER_ID=""

# Token used to verify the webhook subscription with Meta
VERIFY_TOKEN=""

# ─────────────────────────────────────────────
# LLM Provider
# ─────────────────────────────────────────────
# Supported: "openai" (default) or set USE_OPENROUTER=true for OpenRouter
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# Optional — OpenRouter as LLM proxy
USE_OPENROUTER="false"
OPENROUTER_API_KEY=""

# ─────────────────────────────────────────────
# Clinic settings
# ─────────────────────────────────────────────
CLINIC_TIMEZONE="America/Managua"

# ─────────────────────────────────────────────
# Public URL (for .ics calendar links)
# ─────────────────────────────────────────────
# If using ngrok: ngrok http 8000 --domain your-subdomain.ngrok-free.app
PUBLIC_URL=""

# ─────────────────────────────────────────────
# Google Calendar (optional)
# ─────────────────────────────────────────────
# If both are set, appointments are stored in Google Calendar.
# If not, a local JSON file is used as fallback.
GOOGLE_SERVICE_ACCOUNT_FILE="secrets/google-calendar-service-account.json"
GOOGLE_CALENDAR_ID=""

# ─────────────────────────────────────────────
# LangSmith tracing (optional)
# ─────────────────────────────────────────────
LANGSMITH_TRACING="false"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="Dental Clinic Bot"
